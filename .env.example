# ==============================================================================
# Lynk Local Environment Configuration Template
# High-Trust Campus Gig & Freelance Platform (Unified Campus Member Architecture)
# ==============================================================================

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgres://lynk_user:lynk_password@localhost:5432/lynk_db?sslmode=disable
POSTGRES_USER=lynk_user
POSTGRES_PASSWORD=lynk_password
POSTGRES_DB=lynk_db
POSTGRES_MULTIPLE_DATABASES=lynk_db,supertokens_db

# SuperTokens Core Authentication (Self-hosted on port 3567)
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=lynk_supertokens_secret_api_key_2026
API_DOMAIN=http://localhost:8080
WEBSITE_DOMAIN=http://localhost:3000

# MinIO container root credentials (docker-compose MINIO_ROOT_USER / MINIO_ROOT_PASSWORD).
# These mint the S3 access keys the API uses locally. They are NOT interchangeable names:
#   MINIO_ROOT_*  → MinIO server process (compose)
#   MINIO_ACCESS_KEY / MINIO_SECRET_KEY → Go API S3 client (must match root user/password in local compose)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=resumes
MINIO_USE_SSL=false

# Set APP_ENV=production in real deployments. Default secrets log a warning unless APP_ENV is development|dev|local.
APP_ENV=development

# Backend Server Configuration
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
MIGRATIONS_DIR=backend/migrations

# Frontend Public Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
