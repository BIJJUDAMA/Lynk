{
  "id": "lynk",
  "realm": "lynk",
  "displayName": "Lynk Platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "student",
        "description": "Verified university student role"
      },
      {
        "name": "employer",
        "description": "Campus or local employer role"
      },
      {
        "name": "admin",
        "description": "System administrator role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "lynk-frontend",
      "name": "Lynk Next.js Web App",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "lynk-api",
      "name": "Lynk Go REST API Resource Server",
      "enabled": true,
      "bearerOnly": true
    }
  ]
}
